2" y="380" width="24" height="24" as="geometry"/></mxCell><mxCell id="mark-F13" value="F13" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;fontStyle=1;fontSize=10;fontColor=#8a1c16;" vertex="1" parent="1"><mxGeometry x="1092" y="70" width="24" height="24" as="geometry"/></mxCell><mxCell id="mark-F14" value="F14" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;fontStyle=1;fontSize=10;fontColor=#8a1c16;" vertex="1" parent="1"><mxGeometry x="1092" y="380" width="24" height="24" as="geometry"/></mxCell><mxCell id="mark-F15" value="F15" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;fontStyle=1;fontSize=10;fontColor=#8a1c16;" vertex="1" parent="1"><mxGeometry x="1342" y="70" width="24" height="24" as="geometry"/></mxCell><mxCell id="leg0" value="Existing GaaR" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1;fontSize=11;fontColor=#1f2328;" vertex="1" parent="1"><mxGeometry x="20" y="8" width="176" height="24" as="geometry"/></mxCell><mxCell id="leg1" value="New in block 1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1;fontSize=11;fontColor=#1f2328;" vertex="1" parent="1"><mxGeometry x="210" y="8" width="176" height="24" as="geometry"/></mxCell><mxCell id="leg2" value="The four agents M1–M4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;fontSize=11;fontColor=#1f2328;" vertex="1" parent="1"><mxGeometry x="400" y="8" width="176" height="24" as="geometry"/></mxCell><mxCell id="leg3" value="A named person" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1;fontSize=11;fontColor=#1f2328;" vertex="1" parent="1"><mxGeometry x="590" y="8" width="176" height="24" as="geometry"/></mxCell><mxCell id="leg4" value="F# = failure point (page 2)" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#1f2328;" vertex="1" parent="1"><mxGeometry x="806" y="8" width="190" height="24" as="geometry"/></mxCell><mxCell id="leg5" value="" style="ellipse;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="782" y="9" width="22" height="22" as="geometry"/></mxCell><mxCell id="title" value="GaaR · RaaS block 1, kit v34" style="text;html=1;align=right;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#1f2328;" vertex="1" parent="1"><mxGeometry x="1000" y="8" width="380" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Failure register" id="b1-fail"><mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="800" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="register" value="&lt;table border=&quot;1&quot; cellpadding=&quot;4&quot; style=&quot;border-collapse:collapse;font-size:11px;width:100%&quot;&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;ID&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;Failure&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;Where&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;What happens&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;Fix&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;Caught today?&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;Risk&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;F1&lt;/td&gt;&lt;td&gt;No MAS items reach M1&lt;/td&gt;&lt;td&gt;Watch&lt;/td&gt;&lt;td&gt;Your Mac is not subscribed to MAS alerts, and the FCA emails carry no links, so the chain never starts for a real publication.&lt;/td&gt;&lt;td&gt;Subscribe to MAS alerts on the Mac.&lt;/td&gt;&lt;td&gt;Shown&lt;/td&gt;&lt;td&gt;low&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;F2&lt;/td&gt;&lt;td&gt;The wrong document is saved&lt;/td&gt;&lt;td&gt;Inbox → M1&lt;/td&gt;&lt;td&gt;M1 pins the hash of whatever file was saved. Nothing checks that file against the page the watch saw, so an older or different version passes.&lt;/td&gt;&lt;td&gt;Record the fetched page&amp;#x27;s hash when the site allows it; otherwise a second person confirms the file.&lt;/td&gt;&lt;td&gt;Not caught&lt;/td&gt;&lt;td&gt;medium&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;F3&lt;/td&gt;&lt;td&gt;PDF text loses structure&lt;/td&gt;&lt;td&gt;M1&lt;/td&gt;&lt;td&gt;Tables and columns can come out garbled, and obligations inside them are missed. M1 refuses only when it finds none at all.&lt;/td&gt;&lt;td&gt;Compare obligation counts with the publication&amp;#x27;s paragraph numbering.&lt;/td&gt;&lt;td&gt;Partial&lt;/td&gt;&lt;td&gt;low&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;F4&lt;/td&gt;&lt;td&gt;An amendment lands on the wrong control&lt;/td&gt;&lt;td&gt;M1&lt;/td&gt;&lt;td&gt;Matching needs three shared distinctive terms, so a passage can amend the wrong control or be proposed as new. The per-item decision is the only guard.&lt;/td&gt;&lt;td&gt;Reviewer spot-checks M1 on a real MAS publication (B2-3).&lt;/td&gt;&lt;td&gt;Partial&lt;/td&gt;&lt;td&gt;medium&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;F5&lt;/td&gt;&lt;td&gt;One stray proposal blocks every period&lt;/td&gt;&lt;td&gt;Orchestrator&lt;/td&gt;&lt;td&gt;Every watch-linked proposal in the tenant counts toward every order. One undecided proposal on an unrelated publication makes each period incomplete, so no warranty is issued.&lt;/td&gt;&lt;td&gt;Scope proposals to the order&amp;#x27;s framework and period (block 2).&lt;/td&gt;&lt;td&gt;Not fixed&lt;/td&gt;&lt;td&gt;high&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;F6&lt;/td&gt;&lt;td&gt;The owner supplies the corrected export&lt;/td&gt;&lt;td&gt;M3&lt;/td&gt;&lt;td&gt;A rerun proves the rule no longer fires on the export the owner sent. It does not prove production changed. The fix is to re-collect under a signed field mandate.&lt;/td&gt;&lt;td&gt;Re-collect the corrected export under a signed field mandate (block 3 connectors).&lt;/td&gt;&lt;td&gt;Not caught&lt;/td&gt;&lt;td&gt;high&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;F7&lt;/td&gt;&lt;td&gt;Some findings can never be retested&lt;/td&gt;&lt;td&gt;M3&lt;/td&gt;&lt;td&gt;Findings from change_segregation:1 (self-approval) and change_population:1 have no rerun test yet, so they can only end in a risk acceptance.&lt;/td&gt;&lt;td&gt;Add rerun tests for change_segregation:1 and change_population:1.&lt;/td&gt;&lt;td&gt;Gap&lt;/td&gt;&lt;td&gt;medium&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;F8&lt;/td&gt;&lt;td&gt;One fact opens two exceptions&lt;/td&gt;&lt;td&gt;Series hook&lt;/td&gt;&lt;td&gt;An exception is keyed by element, rule and change. A mapping that lists one rule under two elements would open, and bill, two exceptions for one fact. Your current mapping does not: 13 findings, 13 facts.&lt;/td&gt;&lt;td&gt;Count closure fees per rule and change, not per element.&lt;/td&gt;&lt;td&gt;Latent&lt;/td&gt;&lt;td&gt;low&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;F9&lt;/td&gt;&lt;td&gt;The planted cases are our own&lt;/td&gt;&lt;td&gt;M2&lt;/td&gt;&lt;td&gt;Planted cases come from GaaR&amp;#x27;s twin. An agent tuned to the twin scores well, and the bound then measures the twin, not the bank&amp;#x27;s records.&lt;/td&gt;&lt;td&gt;The independent reviewer&amp;#x27;s adversarial pack; planted cases built from real pilot records (B2-2).&lt;/td&gt;&lt;td&gt;Stated&lt;/td&gt;&lt;td&gt;high&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;F10&lt;/td&gt;&lt;td&gt;The bound assumes independent cases&lt;/td&gt;&lt;td&gt;M2&lt;/td&gt;&lt;td&gt;The exact bound treats 500 cases as independent trials. Cases drawn from one generator are correlated, so the real uncertainty is wider than 0.95% suggests.&lt;/td&gt;&lt;td&gt;State the correlation limit on the pack; test with independent case generators.&lt;/td&gt;&lt;td&gt;Not modelled&lt;/td&gt;&lt;td&gt;medium&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;F11&lt;/td&gt;&lt;td&gt;The tenant key sits beside the agent&lt;/td&gt;&lt;td&gt;Tenant key&lt;/td&gt;&lt;td&gt;The key is a file on the same machine. An agent with file access could derive the seed and know the cases. Losing ~/gaar-raas loses the key register. There is no HSM and no rotation yet.&lt;/td&gt;&lt;td&gt;Keep the key outside the agent&amp;#x27;s reach; log key rotation in the register.&lt;/td&gt;&lt;td&gt;Partial&lt;/td&gt;&lt;td&gt;medium&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;F12&lt;/td&gt;&lt;td&gt;Separation of duties compares names&lt;/td&gt;&lt;td&gt;People&lt;/td&gt;&lt;td&gt;Fixer, retester, risk acceptor, claimant and assessor are compared as typed names. One person using two spellings passes every rule. This is the L1 identity limit again.&lt;/td&gt;&lt;td&gt;Bind each role to a personal signing key, as the series signers already are.&lt;/td&gt;&lt;td&gt;Not caught&lt;/td&gt;&lt;td&gt;high&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;F13&lt;/td&gt;&lt;td&gt;A sealed period cannot be corrected&lt;/td&gt;&lt;td&gt;Passport&lt;/td&gt;&lt;td&gt;There is no superseding pack yet, so a mistake found after sealing stays sealed.&lt;/td&gt;&lt;td&gt;A superseding pack that names the one it replaces.&lt;/td&gt;&lt;td&gt;Gap&lt;/td&gt;&lt;td&gt;medium&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;F14&lt;/td&gt;&lt;td&gt;Warranty economics rest on assumptions&lt;/td&gt;&lt;td&gt;M4&lt;/td&gt;&lt;td&gt;The reserve (10% of fee) and expected claims use an assumed 10% defect prevalence. The monitored-only price is unset, so controls in the 1–3% band are not billed.&lt;/td&gt;&lt;td&gt;Replace assumptions with observed rates after four quarters.&lt;/td&gt;&lt;td&gt;Stated&lt;/td&gt;&lt;td&gt;low&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;F15&lt;/td&gt;&lt;td&gt;One shared token, plain HTTP&lt;/td&gt;&lt;td&gt;API&lt;/td&gt;&lt;td&gt;The API uses a single bearer token over plain HTTP on localhost. That is fine on the Mac, not for a bank-hosted install.&lt;/td&gt;&lt;td&gt;Per-user tokens and TLS for a bank-hosted install (block 3).&lt;/td&gt;&lt;td&gt;Known&lt;/td&gt;&lt;td&gt;low&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="1360" height="760" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>